name: CICD

on:
  workflow_dispatch:
    inputs:
      environment:
        description: This is the environment value where the workflow triggers
        default: 'dev'
        required: true
        type: choice
        options:
          - dev
          - prod
          - stagging
          
jobs:
  Code:
    runs-on: ubuntu-slim
    steps:
      - name: Building code
        run: echo "Gather code from GH"
  Build:
    needs: Code
    runs-on: ubuntu-slim
    steps:
      - name: Building code from GH
        run: echo "build tool bulding appln"

  Test:
    needs: Build
    runs-on: ubuntu-slim
    steps:
      - name: Testing Application
        run: echo "Testing is in progress..."
             echo "Testing is completed.!"

  Deoloy:
    needs: Test
    runs-on: ubuntu-slim
    steps:
      - name: Deply Application EC2
        run: echo "Deployment is completed"
